<script
  src="{{ 'custom-blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<custom-blog-posts-list section-id="{{ section.id }}">
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div
    class="
      section
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      blog-posts
      spacing-style
      size-style
    "
    data-testid="blog-posts"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% content_for 'blocks' %}

    {% assign articles_per_page = 2 %}

    {% paginate blog.articles by articles_per_page %}
      <div
        ref="grid"
        class="blog-posts-container"
        data-last-page="{{ paginate.pages }}"
      >
        {% for article in blog.articles %}
          {% # Keep the mobile breakpoint in the style block below in sync with the responsive image sizes above. %}
          {% style %}
            [data-blog-index="{{ section.id }}-{{ forloop.index }}"] {
            }

            @media screen and (max-width: 749px) {
              [data-blog-index="{{ section.id }}-{{ forloop.index }}"] {
              }
            }
          {% endstyle %}
          <div
            id="{{ section.id }}-{{ article.id }}"
            class="blog-post-item"
            data-testid="blog-post-item"
            data-blog-index="{{ section.id }}-{{ forloop.index }}"
            data-page="{{ paginate.current_page }}"
            ref="cards[]"
          >
            {% content_for 'block',
              id: 'static-blog-post-card',
              type: '_blog-post-card',
              article: article,
              is_horizontal: false
            %}
          </div>
        {% endfor %}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav
          class="blog-posts-pagination"
          aria-label="{{ 'content.pagination.nav_label' | t }}"
        >
          <button
            type="button"
            class="button-secondary blog-posts-pagination__button blog-posts-pagination__previous"
            ref="paginationPrevious"
            on:click="/onPaginationPreviousClick"
            {% unless paginate.previous %}
              disabled
            {% endunless %}
          >
            {{ 'content.pagination.previous' | t }}
          </button>
          <button
            type="button"
            class="button-secondary blog-posts-pagination__button blog-posts-pagination__next"
            ref="paginationNext"
            on:click="/onPaginationNextClick"
            {% unless paginate.next %}
              disabled
            {% endunless %}
          >
            {{ 'content.pagination.next' | t }}
          </button>
        </nav>
      {%- endif -%}
    {% endpaginate %}
  </div>
</custom-blog-posts-list>

{% stylesheet %}
  /**
   * Blog posts page layout
   */
  .blog-posts {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));

    /* Keep the responsive image sizes above in sync with this gap. */
    --columns-gap: 36px;
    --rows-gap: 36px;
  }

  .blog-posts-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    width: 100%;
    column-gap: var(--columns-gap);
    row-gap: var(--rows-gap);
  }

  /**
   * Blog post item grid positioning and scaling.
   * Layout is calculated in Liquid based on total article count.
   * Mobile overrides are applied per-item in inline styles for proper specificity.
   */
  .blog-post-item {
    grid-column: span var(--col-span);
    background-color: var(--color-background);
  }

  /**
   * When there's no image, the blog post item has a border.
   */
  .blog-post-item {
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    padding: 0 1rem 1rem;
  }

  .blog-post-item:has(.blog-post-card__image-container) {
    border: none;
    padding: 0;
  }

  .blog-posts-pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: var(--padding-xl) 0 0;
  }

  .blog-posts-pagination__button:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
